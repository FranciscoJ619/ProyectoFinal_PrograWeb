# =====================================================================
#  Replay Club API - archivo de ejemplo
#  Copia este archivo como application.properties (mismo directorio)
#  y llena los valores reales. application.properties NO se sube a GitHub.
# =====================================================================
spring.application.name=replay-club-api
server.port=8010

# ---------- Base de datos MySQL ----------
spring.datasource.url=jdbc:mysql://localhost:3306/replay_club?useSSL=false&serverTimezone=America/Mexico_City&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
spring.datasource.username=
spring.datasource.password=

# Las tablas las crea Flyway (src/main/resources/db/migration). JPA no genera nada.
spring.jpa.hibernate.ddl-auto=none
spring.jpa.open-in-view=false
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.default_batch_fetch_size=50
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

# ---------- JWT ----------
# Clave en Base64 de al menos 256 bits (ej. openssl rand -base64 48)
app.jwt.secret=
# Duración del token en milisegundos (8 horas)
app.jwt.expiration-ms=28800000

# ---------- URLs ----------
# URL pública del frontend (se usa en los enlaces de los correos)
app.frontend-url=http://localhost:5173
# Orígenes permitidos para CORS (separados por coma)
app.cors.allowed-origins=http://localhost:5173

# ---------- Archivos subidos (fotos de juegos y avatares) ----------
app.uploads.dir=./uploads
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=6MB

# ---------- Correo (Postfix local en el VPS) ----------
app.mail.enabled=false
app.mail.from=Replay Club <no-reply@tu-dominio.com>
spring.mail.host=localhost
spring.mail.port=25
spring.mail.username=
spring.mail.password=
spring.mail.properties.mail.smtp.auth=false
spring.mail.properties.mail.smtp.starttls.enable=false

# ---------- Twilio (SMS y WhatsApp) ----------
app.twilio.enabled=false
app.twilio.account-sid=
app.twilio.auth-token=
# Número de Twilio para SMS en formato E.164, ej. +15005550006
app.twilio.sms-from=
# Remitente de WhatsApp (sandbox de Twilio: whatsapp:+14155238886)
app.twilio.whatsapp-from=whatsapp:+14155238886
